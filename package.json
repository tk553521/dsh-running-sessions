{
  "name": "dsh-running-sessions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Live active conversation list with one-click DSH session navigation.",
  "exports": {".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg"},
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale", "README.md", "icon.svg"],
  "engines": {"dsh": ">=0.2.2-rc.3 <0.3.0"},
  "dsh": {"bundle": {"patch": "./cordis.patch.yml"}, "client": {"platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-session"]}}
}
